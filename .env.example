# Copy to .env.local and fill in from Supabase: Project Settings → API Keys.
SUPABASE_URL=https://your-project.supabase.co
# The secret key (sb_secret_…). Server only: never add a NEXT_PUBLIC_ prefix.
SUPABASE_SECRET_KEY=

# Resend (https://resend.com): API Keys → Create. Sends password reset emails.
RESEND_API_KEY=
# Who emails come from, once the shop's domain is verified in Resend, e.g.
# Cherry Thrifts <hello@yourdomain.com>. Until then Resend's test sender is used.
EMAIL_FROM=
# The live site's address, for links in emails, e.g. https://cherrythrifts.in
SITE_URL=
